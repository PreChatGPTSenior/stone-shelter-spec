{
  "name": "stone-shelter-ui",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.21.0",
    "npm": "11.19.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "vite --mode api",
    "dev:mock": "vite --mode mock",
    "build": "tsc --noEmit && vite build",
    "build:mock": "tsc --noEmit && vite build --mode mock",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest",
    "test:api": "node scripts/api-smoke.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "jsdom": "30.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
