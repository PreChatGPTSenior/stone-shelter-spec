{
  "name": "stone-shelter-spec",
  "version": "1.0.0",
  "private": true,
  "description": "Stone Shelter product specification and lightweight static-analysis scaffold",
  "engines": {
    "node": "24.21.0",
    "npm": "11.19.0"
  },
  "scripts": {
    "openspec": "openspec",
    "check": "npm run check:specs && npm run check:quality",
    "check:specs": "openspec validate --all --strict",
    "quality:setup": "python3 tools/static_analysis.py setup",
    "check:quality": "python3 tools/static_analysis.py fixtures",
    "check:java": "python3 tools/static_analysis.py java",
    "lint": "python3 tools/static_analysis.py lint"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.14.3"
  }
}
