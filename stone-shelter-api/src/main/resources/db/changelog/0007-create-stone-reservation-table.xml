<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
  <changeSet id="0007-create-stone-reservation-table" author="stone-shelter">
    <createTable tableName="stone_reservation">
      <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true" nullable="false"/></column>
      <column name="stone_id" type="BIGINT"><constraints nullable="false" unique="true" uniqueConstraintName="uk_stone_reservation_stone"/></column>
      <column name="applicant_name" type="TEXT"><constraints nullable="false"/></column>
      <column name="contact_details" type="TEXT"><constraints nullable="false"/></column>
      <column name="created_at" type="TIMESTAMP WITH TIME ZONE"><constraints nullable="false"/></column>
    </createTable>
    <addForeignKeyConstraint baseTableName="stone_reservation" baseColumnNames="stone_id"
                             referencedTableName="stone" referencedColumnNames="id"
                             constraintName="fk_stone_reservation_stone" onDelete="CASCADE"/>
  </changeSet>
</databaseChangeLog>
